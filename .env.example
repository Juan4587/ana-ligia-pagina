# =============================================================
# Portal Legislativo Ana Ligia Mora — Configuración
# Copia este archivo a .env y completa cada valor.
# =============================================================

# URL pública donde quedará alojado el portal (para enlaces en correos, opcional).
# En Railway se puede dejar vacío (se usa la URL que asigna la plataforma) o
# escribir la del dominio custom.
APP_URL="http://localhost:3000"

# Carpeta donde se guardan SOLO los datos de la aplicación:
# la base de datos SQLite (data/app.db) y los archivos subidos.
# Debes respaldar esta carpeta (es todo lo que contiene la información).
DATA_DIR="./data"

# Clave maestra de cifrado (AES-256) para los datos personales y el contenido
# de los radicados (nombre, correo, teléfono, descripción, respuesta).
# Cámbiala. Si la pierdes, no podrás leer los datos viejos.
# Genera una:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="cambia-esta-clave-encriptacion"

# ---------------- Inteligencia Artificial (Google Gemini) ----------------
# Clave API gratuita de Google AI Studio: https://aistudio.google.com/
# Si se define, genera análisis técnico y borradores de respuesta automáticos para el despacho.
# Si está vacía, el sistema usa plantillas institucionales estándar sin costo ni error.
GEMINI_API_KEY=""

# ---------------- Usuarios del Despacho (admin) ----------------
# El panel del Despacho ya NO usa una clave compartida (ADMIN_KEY).
# Se accede con CORREO + CLAVE por usuario. Crea el primer usuario con:
#   npx tsx scripts/seed_admin_user.ts "Nombre Completo" correo@despacho.co "clave-segura"
# Cada usuario y sus acciones sensibles quedan en la tabla de auditoría.

# ---------------- Correos (Resend) ----------------
# Regístrate gratis en https://resend.com y crea una API key.
# Si está vacía, el portal funciona igual pero NO envía correos
# (se muestra un aviso visible al arrancar el servidor).
RESEND_API_KEY=""

# Remitente verificado en Resend (debe estar autorizado en tu cuenta).
# En pruebas usa:  "Acme <onboarding@resend.dev>"  (con verificación real: "Departamento Legislativo <no-reply@tudominio.co>")
EMAIL_FROM="Departamento Legislativo <onboarding@resend.dev>"

# Buzón del despacho donde llegan los avisos de nuevos radicados (clasificados por tema).
DESPACHO_EMAIL="ana.mora@camara.gov.co"

# ---------------- Política de retención ----------------
# Días después de los cuales un radicado sin actividad se ANONIMIZA automáticamente
# (se borran nombre, correo y teléfono; se conserva el contenido cifrado y el radicado).
# Para el periodo 2026-2030 se recomienda 1460 días (4 años).
# Poner 0 desactiva la anonimización automática.
ANONYMIZE_AFTER_DAYS="1460"

# Fin del periodo legislativo (YYYY-MM-DD). Al llegar esa fecha, el sistema ANONIMIZA
# todos los radicados (conserva número y contenido cifrado) y elimina los adjuntos.
# Dejar vacío desactiva el cierre de periodo.
PERIOD_END_DATE="2030-07-20"