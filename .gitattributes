# Normaliza todos los archivos de texto a LF (Linux) al hacer commit.
# Railway (Linux) puede fallar con CRLF en scripts y archivos .cjs/.mjs.
* text=auto eol=forzado

# Forzar LF para tipos específicos que fallan con CRLF en Linux
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.env text eol=lf

# Binarios: no tocar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.sqlite binary
*.db binary
